NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Demo accounts (optional) — shown as quick-access buttons on the login screen.
# Create these accounts in Supabase Auth with the matching role in the profiles table.
# Admin demo is intentionally excluded; admin access requires a real sign-in.
NEXT_PUBLIC_DEMO_CLIENT_EMAIL=demo-client@campaway.dev
NEXT_PUBLIC_DEMO_CLIENT_PASSWORD=
NEXT_PUBLIC_DEMO_DESIGNER_EMAIL=demo-designer@campaway.dev
NEXT_PUBLIC_DEMO_DESIGNER_PASSWORD=
